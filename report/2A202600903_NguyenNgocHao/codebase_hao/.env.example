# LLM Configuration for demo_rag.py
LLM_API_BASE=http://localhost:20128/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=kr/claude-sonnet-4.5

# Embedding provider selection (optional for manual experiments)
# EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai

# Optional: OpenAI embedding configuration
# OPENAI_API_KEY=your-key-here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: for ChromaDB persistence (bonus task)
# CHROMA_PERSIST_DIR=./chroma_data
